### 3C - MLS ARG Richness


```{r}
gr_data_new <-AMR_NS_single %>%
  group_by(sample_id, abx_class) %>%
  dplyr::mutate(mls_gene_count=n()) %>%
  ungroup() %>%
  dplyr::filter(abx_class=="MLS") %>%
  dplyr::select(sample_id,mls_gene_count) %>%
  distinct()

gr_data2_new <- AMR_NS_single %>%
  left_join(gr_data_new) %>%
  dplyr::mutate(mls_gene_count = ifelse(is.na(mls_gene_count),0,mls_gene_count))%>%
  distinct(sample_id, mls_gene_count) %>%
  left_join(clinical_data %>% dplyr::select(sample_id, participant_id, event_date, ever_steroids,trajectory_group, discretized_admit_age_quantile, sex, enrollment_site)) %>%
  dplyr::filter(!is.na(participant_id)) %>%
  left_join(ABX_days_NS_ST_new %>% dplyr::select(sample_id, Azithromycin, ABX_days, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem)) %>%
  dplyr::filter(!is.na(ABX_days)) %>%
  dplyr::filter(sample_id %in% NS_group_timepoint_data_0306$sample_id) %>%
  left_join(NS_group_timepoint_data_0306 %>% dplyr::select(sample_id,group_id,timepoint)) %>%
  dplyr::filter(!is.na(timepoint), !is.na(group_id)) %>%
    dplyr::mutate(Azith_other_one_zero = ifelse(group_id == "Azithromycin", 1,
                                       ifelse(group_id == "Other ABX", 0, NA))) %>%
  dplyr::select(sample_id, group_id, timepoint, mls_gene_count, event_date, participant_id, ever_steroids,trajectory_group, discretized_admit_age_quantile, sex, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem, ABX_days, enrollment_site, Azith_other_one_zero) %>%
  distinct()

sample_sizes_new <- gr_data2_new %>%
  dplyr::select(sample_id, group_id, timepoint) %>%
  distinct() %>%
  group_by(group_id,timepoint) %>%
  summarise(n = n(), .groups = "drop")

stats_df_mls_gene_new <- gr_data2_new %>%
  group_by(timepoint) %>%
  wilcox_test(mls_gene_count ~ group_id) %>%
  dplyr::mutate(p.adj = p.adjust(p = p, method = "fdr"), y.position=c(8,9,10,8,9,10)) %>%
  add_significance(p.col = "p.adj") %>%
  dplyr::mutate(p_char = case_when(p.adj<0.01 ~ format(p.adj, scientific=TRUE, digits=2), p.adj>0.045 & p.adj<0.05 ~ as.character(format(round(p.adj,digits=3), nsmall = 2)), p.adj>0.0095 & p.adj<0.01 ~ as.character(format(round(p.adj,digits=3), nsmall = 2)), TRUE ~ as.character(format(round(p.adj,digits=2), nsmall = 2))))

### linear ###
out_df <- data.frame()
for(comparison in list(c("Azithromycin", "No ABX"), c("Azithromycin", "Other ABX"), c("No ABX", "Other ABX"))){
  for(act_timepoint in unique(gr_data2_new$timepoint)){
    data<-gr_data2_new %>% ungroup() %>%
      filter(timepoint == act_timepoint) %>%
      filter(group_id %in% comparison)
    fit <- lme4::lmer(data=data, formula = mls_gene_count ~ group_id + event_date + ever_steroids + trajectory_group + discretized_admit_age_quantile + sex + Ceftriaxone + Vancomycin + Cefepime + Piperacillin_Tazobactam + Doxycycline + Meropenem + (1|participant_id))
    fit2 <- lme4::lmer(data=data, formula = mls_gene_count ~ event_date + ever_steroids + trajectory_group + discretized_admit_age_quantile + sex + Ceftriaxone + Vancomycin + Cefepime + Piperacillin_Tazobactam + Doxycycline + Meropenem + (1|participant_id))
    an <- anova(fit, fit2)
    out_df <- rbind.data.frame(out_df, data.frame(name = "mls_gene_count", timepoint = act_timepoint,
                                          group1 = comparison[1],group2 = comparison[2],
                                          p = an$`Pr(>Chisq)`[2]))}}
out_df <- out_df %>% group_by(name, timepoint) %>% mutate(p.adj = p.adjust(p, "fdr"))
stats_df_mls_gene_new2 <- stats_df_mls_gene_new %>% select(-p.adj, -p) %>% left_join(out_df) %>%
  dplyr::mutate(p_char = case_when(p.adj<0.01 ~ format(p.adj, scientific=TRUE, digits=2), p.adj>0.045 & p.adj<0.05 ~ as.character(format(round(p.adj,digits=3), nsmall = 2)), p.adj>0.0095 & p.adj<0.01 ~ as.character(format(round(p.adj,digits=3), nsmall = 2)), TRUE ~ as.character(format(round(p.adj,digits=2), nsmall = 2))))


### linear model v2 ###
