### Figure 3F, S4 - Post-Azithro Analysis


```{r postazithro}
stop_dates<-startstop %>% filter(med_group=="Azithromycin")

post_data_new<-AMR_NS_single %>%
  left_join(NS_group_timepoint_data1_new) %>%
  left_join(clinical_data) %>%
  left_join(stop_dates)

### 37 participants
mid_participants_new<-post_data_new %>%
  filter(group_id=="Azithromycin", timepoint=="Day 4-6") %>%
  dplyr::select(participant_id) %>%
  distinct()

### 62 samples
mid_samples_new<-post_data_new %>%
  filter(group_id=="Azithromycin", timepoint=="Day 4-6") %>%
  dplyr::select(sample_id) %>%
  distinct()

### full 4-6 data
mid_data_new<-post_data_new %>%
  filter(group_id=="Azithromycin", timepoint=="Day 4-6")

### All samples post-azithro - 42 samples
all_late_new<-post_data_new %>%
  filter(participant_id %in% mid_participants_new$participant_id) %>% 
  left_join(ABX_days_NS_ST_new %>% dplyr::select(sample_id, Azithromycin, ABX_days, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem)) %>%
  dplyr::select(participant_id, sample_id,event_date, Azithromycin, admit_month, event_type, conmed_dose_stop, ever_steroids, trajectory_group, discretized_admit_age_quantile, sex, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem)%>%
  distinct() %>%
  mutate(days_since_stop=event_date-conmed_dose_stop) %>%
  filter(days_since_stop>0)

### 12 samples
late_710_new<-all_late_new %>%
  filter(days_since_stop>=7 & days_since_stop<=10)

compare_new<-post_data_new %>% 
  mutate(late_compare_new=case_when(sample_id %in% late_710_new$sample_id ~ "7-10 Days\nAfter Cessation", (group_id=="Azithromycin" & timepoint=="Day 4-6") ~ "5 \u00b1 1 Days\nof Exposure", TRUE ~ "None")) %>%
  filter(late_compare_new!="None") %>%
  left_join(ABX_days_NS_ST_new %>% dplyr::select(sample_id, Azithromycin, ABX_days, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem)) %>%
  dplyr::select(sample_id, late_compare_new, event_date, participant_id, ever_steroids,trajectory_group, discretized_admit_age_quantile, sex, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem) %>%
  distinct()

compare_all_new<-post_data_new %>% 
  mutate(late_compare_new=case_when(sample_id %in% all_late_new$sample_id ~ "After Azithromycin\nCessation", (group_id=="Azithromycin" & timepoint=="Day 4-6") ~ "5 \u00b1 1 Days\nof Exposure", TRUE ~ "None")) %>%
  filter(late_compare_new!="None") %>%
  left_join(ABX_days_NS_ST_new %>% dplyr::select(sample_id, Azithromycin, ABX_days, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem)) %>%
  dplyr::select(sample_id, late_compare_new, event_date, participant_id, ever_steroids,trajectory_group, discretized_admit_age_quantile, sex, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem) %>%
  distinct()

### Figure 3F
gr_data3_new<-gr_data2_new %>%
  filter(sample_id %in% compare_new$sample_id) %>%
  left_join(compare_new) %>%
  dplyr::select(sample_id, late_compare_new, mls_gene_count, event_date, participant_id, ever_steroids,trajectory_group, discretized_admit_age_quantile, sex, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem) %>%
  distinct()

sample_sizes_new <- gr_data3_new %>%
  dplyr::select(sample_id, late_compare_new) %>%
  distinct() %>%
  group_by(late_compare_new) %>%
  summarise(n = n(), .groups = "drop")

stats_df_mls_gene_new <- gr_data3_new %>%
  wilcox_test(mls_gene_count ~ late_compare_new) %>%
  dplyr::mutate(y.position=9) %>%
  add_significance(p.col = "p") %>%
  dplyr::mutate(p_char = case_when(p<0.01 ~ format(p, scientific=TRUE, digits=2), p>0.045 & p<0.05 ~ as.character(format(round(p,digits=3), nsmall = 2)), p>0.0095 & p<0.01 ~ as.character(format(round(p,digits=3), nsmall = 2)), TRUE ~ as.character(format(round(p,digits=2), nsmall = 2))))

### linear stats ###
out_df <- data.frame()
fit <- lme4::lmer(data=gr_data3_new, formula = mls_gene_count ~ late_compare_new + event_date + ever_steroids + trajectory_group + discretized_admit_age_quantile + sex + Ceftriaxone + Vancomycin + Cefepime + Piperacillin_Tazobactam + Doxycycline + Meropenem + (1|participant_id))
fit2 <- lme4::lmer(data=gr_data3_new, formula = mls_gene_count ~ event_date + ever_steroids + trajectory_group + discretized_admit_age_quantile + sex + Ceftriaxone + Vancomycin + Cefepime + Piperacillin_Tazobactam + Doxycycline + Meropenem + (1|participant_id))
an <- anova(fit, fit2)
out_df <- rbind.data.frame(out_df, data.frame(name = "mls_gene_count", group1 ="5 \u00b1 1 Days\nof Exposure", group2 = "7-10 Days\nAfter Cessation", p = an$`Pr(>Chisq)`[2]))
out_df2<-out_df %>% dplyr::mutate(p_char = case_when(p<0.01 ~ format(p, scientific=TRUE, digits=2), p>0.045 & p<0.05 ~ as.character(format(round(p,digits=3), nsmall = 2)), p>0.0095 & p<0.01 ~ as.character(format(round(p,digits=3), nsmall = 2)), TRUE ~ as.character(format(round(p,digits=2), nsmall = 2)))) %>% dplyr::mutate(y.position=9) 
write.csv(out_df2, "3F_stats.csv")
gr_data3_new %>%
  dplyr::mutate(late_compare_new = factor(late_compare_new, c("5 \u00b1 1 Days\nof Exposure", "7-10 Days\nAfter Cessation"))) %>%
  ggplot(aes(x=late_compare_new, y=mls_gene_count, color = late_compare_new, group = late_compare_new)) +
  geom_violin(trim=FALSE,alpha=0.5) +
  geom_boxplot(outlier.shape = NA, width=0.1) +
  geom_jitter(size=1,alpha=0.2, width=0.4) +
  #ggbeeswarm::geom_quasirandom(size = 1, alpha=0.5) +
  theme_classic() +
  labs(color="Timepoint") +
  #scale_y_log10()+
  theme(axis.text.x = element_text(size=10), 
        axis.text.y = element_text(size=10), 
        legend.text = element_text(size=10)) +
  stat_pvalue_manual(out_df2, label="p_char", size=4) +
  ylab("Number of Detectably Expressed MLS ARGs") + xlab("") + 
  geom_text(data = sample_sizes_new, aes(x = late_compare_new, y = -0.5, label = paste("n =", n)), vjust = 1.5, color = "black") + coord_cartesian(ylim=c(-1,10))

pdf( file = "3F.pdf", width=5, height=2.5)
gr_data3_new %>%
  dplyr::mutate(late_compare_new = factor(late_compare_new, c("5 \u00b1 1 Days\nof Exposure", "7-10 Days\nAfter Cessation"))) %>%
