                   count = n()), "3F_effect_sizes.csv")

### Figure S4
perc_data_new <- AMR_NS_single %>%
  dplyr::filter(sample_id %in% compare_new$sample_id)%>%
  group_by(sample_id) %>%
  dplyr::mutate(sample_total_reads=sum(num_reads)) %>% ### store total reads in each sample
  ungroup() 

mls_perc_new<-perc_data_new %>%
  group_by(sample_id, abx_class) %>%
  dplyr::mutate(class_reads = sum(num_reads)) %>% ### store total reads in each sample/class 
  dplyr::mutate(class_perc=(class_reads/sample_total_reads)*100) %>% ### convert to percent of resistome
  dplyr::mutate(class_perc = ifelse(is.na(class_perc), 0, class_perc)) %>%
  ungroup() %>%
  filter(abx_class=="MLS") %>%
  dplyr::select(sample_id, class_perc) %>%
  distinct()

perc_data_2_new<-perc_data_new %>%
  left_join(mls_perc_new, by="sample_id") %>%
  dplyr::mutate(class_perc=ifelse(is.na(class_perc), 0, class_perc)) %>% ###for samples with no mls 
  dplyr::select(sample_id,class_perc) %>%
  distinct() %>%
  left_join(clinical_data %>% dplyr::select(sample_id, participant_id, event_date, ever_steroids,trajectory_group, discretized_admit_age_quantile, sex)) %>%
  dplyr::filter(!is.na(participant_id)) %>%
  left_join(ABX_days_NS_ST_new %>% dplyr::select(sample_id, Azithromycin, ABX_days, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem)) %>%
  dplyr::filter(!is.na(ABX_days)) %>%
  left_join(compare_new %>% dplyr::select(sample_id,late_compare_new)) %>%
  dplyr::filter(!is.na(late_compare_new)) %>%
  dplyr::select(sample_id,late_compare_new, class_perc, event_date, participant_id, ever_steroids,trajectory_group, discretized_admit_age_quantile, sex, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem) %>%
  distinct()

