### Figures 3D-3E


```{r GAMM summary stats new}
#| echo: false
#| warning: false

ABX_days_NS_GAMM_plus_new <-ABX_days_NS_GAMM_new %>% 
  dplyr::select(-keep) #%>% 
  #rowwise() %>% 
  #dplyr::mutate(ABX_days=rowSums(across(where(is.numeric))))

mlsdpmgamm_new <- AMR_NS_GAMM %>%
  left_join(clinical_data) %>%
  left_join(ABX_days_NS_GAMM_plus_new) %>% #add additional info
  left_join(NS_group_timepoint_data_0306) %>%
  group_by(sample_id) %>%
  dplyr::mutate(sum_dpm=sum(dpm)) %>%
  dplyr::mutate(sum_reads=sum(num_reads)) %>%
  group_by(sample_id, abx_class) %>%
  dplyr::mutate(class_dpm=sum(dpm)) %>% #calc sum DPM MLS
  dplyr::mutate(class_reads=sum(num_reads)) %>%
  dplyr::mutate(pseudo=class_dpm+1) %>%
  dplyr::mutate(logmlsdpm=log10(pseudo)) %>%
  ungroup() %>%
  #dplyr::mutate(logdpm=log10(class_dpm+1)) %>% #transform class DPM
  dplyr::mutate(perc=(class_dpm/sum_dpm)*100) %>% #calc perc MLS of resistome
  dplyr::mutate(perc2=case_when(is.na(perc) ~ 0, TRUE ~ perc)) %>% #convert NA to 0
  dplyr::mutate(perc3=(class_reads/sum_reads)*100) %>% #calc perc MLS of resistome
  dplyr::mutate(perc4=case_when(is.na(perc3) ~ 0, TRUE ~ perc3)) %>% #convert NA to 0
  dplyr::mutate(logmlsdpm=case_when(is.na(logmlsdpm) ~ 0, TRUE ~ logmlsdpm)) %>% #convert NA to 0
  dplyr::filter(abx_class=="MLS") %>% #filter to only MLS
  ungroup() %>%
  dplyr::select(sample_id, ABX_days,logmlsdpm, class_dpm, sum_dpm, perc, perc2, perc3, perc4,Azithromycin, event_date, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem, trajectory_group, sex, discretized_admit_age_quantile, participant_id, enrollment_site, group_id, ever_steroids) %>% 
  distinct() 


### Figure 3E
noabx_perc_new<-mlsdpmgamm_new %>% filter(group_id=="No ABX")
  #filter(ABX_days==0)
noavg_perc_new<-mean(noabx_perc_new$perc4)

formula_fit <- formula(perc4 ~ s(Azithromycin, bs = 'cr', k= 4) +s(event_date, bs = 'cr') + s(Ceftriaxone, bs = 'cr', k= 4) + s(Vancomycin, bs = 'cr', k= 4) + s(Cefepime, bs = 'cr', k= 4) + s(Piperacillin_Tazobactam, bs = 'cr', k= 4) + s(Doxycycline, bs = 'cr', k= 4) + s(Meropenem, bs = 'cr', k= 4) + trajectory_group + sex + discretized_admit_age_quantile + ever_steroids)

fit <- gamm4::gamm4(data = as.data.frame(mlsdpmgamm_new), formula_fit, random = ~(1|enrollment_site/participant_id))

tmp <- data.frame("feature" = "Azithromycin", "p.value" = anova(fit$gam)[["s.pv"]][1])
#tmp
pred <- ggpredict(fit, c("Azithromycin"), type = "fixed", ci_level = CI_interval)
write.csv(pred, "3E_stats.csv")
p3 <-pred %>%
  ggplot(mapping = aes(x = x, y = predicted, fill=group)) +
  geom_line(mapping = aes(y = predicted, x=x), size = 0.8, color="#E07E3D") +
  geom_line(y=noavg_perc_new, color="#4268C6", linetype=2)+
  geom_ribbon(aes(x=x, ymin = conf.low, ymax = conf.high),alpha = 0.3, colour=NA) +
  theme_classic(base_size=14) +
  scale_color_manual(values=c("#E07E3D")) + scale_fill_manual(values=c("#E07E3D")) +
  ylab("MLS Percent of Resistome") + xlab("Days of Azithromycin Exposure") +
  theme(legend.position = "none") +
  coord_cartesian(xlim = c(0, 5), ylim=c(0,70)) +
  geom_text(label=paste("p=",case_when(tmp$p.value<0.01 ~ format(tmp$p.value, scientific=TRUE, digits=2),tmp$p.value>0.045 & tmp$p.value<0.05 ~ as.character(format(round(tmp$p.value,digits=3), nsmall = 2)),  tmp$p.value>0.0095 & tmp$p.value<0.01 ~ as.character(format(round(tmp$p.value,digits=3), nsmall = 2)), TRUE ~ as.character(format(round(tmp$p.value,digits=2), nsmall = 2)))), x=0.5, y=68, size=5)
plot(p3)

my_data<-mlsdpmgamm_new %>%
  select(Azithromycin,perc4)

write.csv(my_data, "3E.csv")

