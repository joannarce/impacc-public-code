fit <- lme4::lmer(data=perc_data_2_new, formula = class_perc ~ late_compare_new + event_date + ever_steroids + trajectory_group + discretized_admit_age_quantile + sex + Ceftriaxone + Vancomycin + Cefepime + Piperacillin_Tazobactam + Doxycycline + Meropenem + (1|participant_id))
fit2 <- lme4::lmer(data=perc_data_2_new, formula = class_perc ~ event_date + ever_steroids + trajectory_group + discretized_admit_age_quantile + sex + Ceftriaxone + Vancomycin + Cefepime + Piperacillin_Tazobactam + Doxycycline + Meropenem + (1|participant_id))
