### 4A - Bar Chart of individual MLS genes


```{r bar chart}
### ID genes to collapse
AMR_NS_single%>% 
  mutate(total=sum(dpm)) %>% ### all reads in entire cohort
  group_by(gene_name2) %>%
  mutate(sum=sum(dpm)) %>% ### sum reads for each gene
  mutate(perc=sum/total*100) %>%  ### generate percent
  filter(abx_class=="MLS") %>%  ### only look at MLS genes
  dplyr::select(gene_name2, perc) %>%  ###show gene name and prevalence
  distinct()

### trim dataset
AMR_NS_MLS_single<-AMR_NS_single %>%
  group_by(sample_id) %>%
  mutate(all_amr=sum(num_reads)) %>%
  ungroup() %>%
  dplyr::filter(abx_class=="MLS")

### Collapse <1% prevalence
AMR_NS_MLS_single2 <-AMR_NS_MLS_single%>%
  dplyr::mutate(gene_name3=case_when(gene_name2 == "lsac" |
                                       gene_name2 == "vgaalc" |
                                       gene_name2 == "vgaa" |
                                       gene_name2 == "ermf" |
                                       gene_name2=="lsaa" |
                                       gene_name2=="lnuc" | 
                                       gene_name2=="mel" |
                                       gene_name2=="lnua" ~ "Other", TRUE ~ gene_name2)) %>%
  group_by(sample_id, gene_name3) %>%
  dplyr::mutate(samplegenesum=sum(num_reads)) %>%
  dplyr::mutate(gene_perc=(samplegenesum/all_amr)*100) %>%
  ungroup() %>%
  group_by(sample_id,abx_class) %>%
  mutate(class_total_reads=sum(num_reads)) %>%
  mutate(gene_perc_class=(samplegenesum/class_total_reads)*100) %>%
  ungroup() %>%
  dplyr::select(sample_id, gene_name3, abx_class, class_total_reads, gene_perc_class, all_amr, samplegenesum) %>%
  distinct()

### Add timepoints 
data_new <-AMR_NS_MLS_single2 %>% 
  left_join(NS_group_timepoint_data_0306) 


### Barplot of full resistome 
custom_colors <- c("msra" = "#C49A00", "erma" = "#F8766D", "ermc" = "#53B400", "mphc" = "#00C094", "ermx" = "#00B6EB","ermb" = "#A58AFF", "Other" = "#FB61D7")
data_new %>%
  filter(timepoint=="Day 4-6", group_id=="Azithromycin") %>%
  mutate(all_mls=sum(samplegenesum)) %>%
  group_by(gene_name3) %>%
  mutate(gene_total=sum(samplegenesum)) %>%
  mutate(gene_perc_all=(gene_total/all_mls)*100) %>%
  dplyr::select(gene_name3,gene_perc_all) %>%
  distinct() %>%
  mutate(gene_name4=as.factor(gene_name3)) %>%
  ggplot(aes(x=fct_reorder(gene_name4, gene_perc_all,.fun = sum, .desc=TRUE), y=gene_perc_all, fill=gene_name4)) + geom_bar(stat="identity") +
  labs(color="ARG Name") +
  scale_fill_manual(values=custom_colors) +
  theme_classic() +  
  labs( x = "ARG", y = "Percent of MLS resistome") +
  theme(axis.text.x = element_text(angle = 45, hjust = 1, size=12),
        axis.text.y = element_text(size=12), legend.position="none")

pdf(file = "4A.pdf", width=5, height=2.5)
