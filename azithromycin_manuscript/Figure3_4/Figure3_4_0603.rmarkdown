      theme(legend.position = "none") +
      coord_cartesian(xlim = c(0, 5)) +
      geom_text(label=paste("p=",case_when(tmp$p.value<0.01 ~ format(tmp$p.value, scientific=TRUE, digits=2),tmp$p.value>0.045 & tmp$p.value<0.05 ~ as.character(format(round(tmp$p.value,digits=3), nsmall = 2)),  tmp$p.value>0.0095 & tmp$p.value<0.01 ~ as.character(format(round(tmp$p.value,digits=3), nsmall = 2)), TRUE ~ as.character(format(round(tmp$p.value,digits=2), nsmall = 2)))), x=0.5, y=3.3, size=5)
plot(p4)

my_data<-richnessgamm_new %>%
  select(Azithromycin, richness)

write.csv(my_data, "3D.csv")

pdf(file="3E.pdf", width=4, height=2.5)
plot(p3)
invisible(capture.output(dev.off()))

pdf(file="3D.pdf", width=4, height=2.5)
plot(p4)
invisible(capture.output(dev.off()))

```


### Figure 3B - Beta Diversity


```{r beta div}
library(vegan)

amr_wide_new <- AMR_NS_single %>%
  left_join(NS_group_timepoint_data_0306) %>%
  dplyr::filter(group_id!="Other ABX", !is.na(group_id)) %>%
  pivot_wider(id_cols = "sample_id", names_from = gene_name, values_from = num_reads) %>%
  column_to_rownames("sample_id") %>%
  mutate_if(is.numeric, ~replace_na(., 0)) 

samples<-row.names(amr_wide_new)

metadata_new<-data.frame(samples) %>% 
  set_names("sample_id") %>%
  left_join(NS_group_timepoint_data_0306) %>%
  dplyr::mutate(group2=case_when(group_id=="Azithromycin" & timepoint=="Day 4-6" ~ "Late Azithromycin", group_id=="Azithromycin" & timepoint=="Day 0-2" ~ "Early Azithromycin", TRUE ~ "No ABX")) %>%
  left_join(clinical_data %>% select(sample_id, participant_id, event_date, discretized_admit_age_quantile, sex, trajectory_group, ever_steroids)) %>%
  left_join(ABX_days_NS_ST_new %>% select(sample_id, Azithromycin, Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem)) %>%
  dplyr::select(sample_id, group2, participant_id, event_date, discretized_admit_age_quantile, sex, trajectory_group, ever_steroids,Ceftriaxone, Vancomycin, Cefepime, Piperacillin_Tazobactam, Doxycycline, Meropenem)

dist_bc <- vegan::vegdist(amr_wide_new, method = "bray")
AMR.dispersion<-betadisper(dist_bc, group=metadata_new$group2)
AMR.permutest<-permutest(AMR.dispersion)
#plot(AMR.dispersion, hull=FALSE, ellipse=TRUE)
set.seed(100)
AMR.div<-adonis2(dist_bc ~ group2 + event_date + participant_id + discretized_admit_age_quantile + sex + trajectory_group + ever_steroids + Ceftriaxone + Vancomycin + Cefepime + Piperacillin_Tazobactam +  Doxycycline + Meropenem, data=metadata_new, permutations = 1000, method="bray")
#print(AMR.div)

pcoa_result <- cmdscale(dist_bc, k = 2, eig = TRUE)
#plot(pcoa_result$points, xlab = "PCoA1", ylab = "PCoA2", main = "PCoA Plot")
PC1 <- pcoa_result$points[,1]
PC2 <- pcoa_result$points[,2]
plot<-cbind(metadata_new, PC1, PC2)
cent <- aggregate(cbind(PC1, PC2) ~ group2, data = metadata_new, FUN = mean)
segs<-merge(plot,setNames(cent, c("group2", "oPC1", "oPC2")), by = "group2", sort = FALSE)

PCA_plot<-ggplot(plot %>% dplyr::mutate(group2=factor(group2, levels=c("Early Azithromycin","Late Azithromycin", "No ABX"))), aes(PC1, PC2, color=group2)) +
  geom_point(alpha=0.5) +
  stat_ellipse(geom = "polygon", type="t",size =1, alpha=0.1, aes(fill=group2)) +  ##draws 95% confidence interval ellipses
  #xlim(-1,1) +
  geom_segment(data = segs, mapping = aes(xend = oPC1, yend = oPC2, alpha=0.1)) + # spiders
  geom_point(data = cent, size = 4) +                         # centroids
#  coord_fixed() +                                              # same axis scaling
  scale_color_manual(labels=c("Early Azithromycin", "Late Azithromycin", "No ABX"), values=c("#E07E3D","brown4","#4268C6")) +
  scale_fill_manual(labels=c("Early Azithromycin","Late Azithromycin","No ABX"), values=c("#E07E3D", "brown4","#4268C6")) +
  annotate("text", x=0.75, y=0.5, label="Early Azithromycin", hjust = 1, color=c("#E07E3D"), size=5) +
  annotate("text", x=-0.1, y=0.5, label="Late Azithromycin", hjust = 1, color=c("brown4"), size=5) +
  annotate("text", x=0.7, y=-0.4, label="No ABX", hjust = 1, color=c("#4268C6"), size=5) +
  annotate("text", x=0.1, y=-0.5, label=paste("PERMANOVA p=0.001"), hjust = 0, size=5) +
  theme(legend.position="none") + theme_bw()


PCA_plot

pdf(file="3B.pdf", width=5.5, height=2.5)
plot(PCA_plot)
invisible(capture.output(dev.off()))

rownames(amr_wide_new)<-NULL
write.csv(amr_wide_new, "3B.csv")

```


## Figure 4B


```{r corrplot prep}
library(ggcorrplot)
library(corrplot)
### select samples
samples<-AMR_NS_GAMM %>%
  left_join(ABX_days_NS_GAMM_new, by="sample_id") %>%
  dplyr::filter(Azithromycin>0) %>%
  dplyr::select(sample_id) %>% 
  distinct()

### AMR data
AMR_corr_mlsdpm_gene<-AMR_NS_GAMM %>%
  dplyr::filter(sample_id %in% samples$sample_id, abx_class=="MLS") %>%
  dplyr::mutate(pseudo=dpm+1) %>%
  dplyr::mutate(logdpm=log10(pseudo)) %>%
  dplyr::select(sample_id, gene_name2, logdpm) %>%
  distinct() %>%
  pivot_wider(names_from = gene_name2, values_from = logdpm, values_fill = 0) 

AMR_corr_mlsperc_gene<-AMR_NS_GAMM %>%
  dplyr::filter(sample_id %in% samples$sample_id) %>%
  group_by(sample_id)%>%
  dplyr::mutate(sum_dpm = sum(dpm)) %>%
  ungroup%>%
  dplyr::filter(abx_class=="MLS") %>%
  dplyr::mutate(perc=(dpm/sum_dpm)*100) %>%
  dplyr::select(sample_id, gene_name2, perc) %>%
  distinct() %>%
  pivot_wider(names_from = gene_name2, values_from = perc, values_fill = 0) 

AMR_corr_mlsdpm_class<-AMR_NS_GAMM %>%
  dplyr::filter(sample_id %in% samples$sample_id) %>%
  group_by(sample_id, abx_class)%>%
  dplyr::mutate(sum_classdpm = sum(dpm)) %>%
  ungroup() %>%
  dplyr::filter(abx_class=="MLS") %>%
  dplyr::mutate(pseudo=sum_classdpm+1) %>%
  dplyr::mutate(logsumdpm=log10(pseudo)) %>%
  dplyr::select(sample_id, abx_class, logsumdpm) %>% 
  distinct() %>%
  pivot_wider(names_from = abx_class, values_from = logsumdpm, values_fill = 0) 

AMR_corr_mlsperc_class<-AMR_NS_GAMM %>%
  dplyr::filter(sample_id %in% samples$sample_id) %>%
  group_by(sample_id)%>%
  dplyr::mutate(sum_dpm = sum(dpm)) %>%
  ungroup%>%
  group_by(sample_id, abx_class)%>%
  dplyr::mutate(sum_dpm_class= sum(dpm)) %>%
  ungroup() %>%
  dplyr::mutate(classperc=(sum_dpm_class/sum_dpm)*100) %>%
  dplyr::filter(abx_class=="MLS") %>%
  dplyr::select(sample_id, abx_class, classperc) %>%
  distinct() %>%
  pivot_wider(names_from = abx_class, values_from = classperc, values_fill = 0) 


### Bacterial Data
Bact_corr<-nasal_long %>%
  dplyr::filter(sample_id %in% samples$sample_id, 
         category=="bacteria", 
         nt_alignment_length>=70, 
         nt_count>=10, 
         nr_count>=1, 
         p_adj<0.1) %>%
  dplyr::select(sample_id, name, nt_rpm) %>%
  pivot_wider(names_from = name, values_from = nt_rpm, values_fill=0) 

microbes <-Bact_corr[c(2, 3:length(Bact_corr))]
tdf<-t(microbes)
data<-as.data.frame(tdf)
with_total<-data %>% dplyr::mutate(sum = rowSums(.)) %>% arrange(desc(sum)) %>% do(head(., n=50))
trimmed_list_microbes<-rownames(with_total)
top50_data<-Bact_corr %>% dplyr::select(sample_id, trimmed_list_microbes)
top50_data[sapply(top50_data, is.numeric)] <- top50_data[sapply(top50_data, is.numeric)] + 1
top50_data[sapply(top50_data, is.numeric)] <-sapply(top50_data[sapply(top50_data, is.numeric)], log10)

combined_corr_dpmclass<-left_join(AMR_corr_mlsdpm_class, top50_data, by="sample_id") %>%
  replace(is.na(.), 0)

combined_corr_percclass<-left_join(AMR_corr_mlsperc_class, top50_data, by="sample_id") %>%
  replace(is.na(.), 0)

combined_corr_dpmgene<-left_join(AMR_corr_mlsdpm_gene, top50_data, by="sample_id") %>%
  replace(is.na(.), 0)

combined_corr_percgene<-left_join(AMR_corr_mlsperc_gene, top50_data, by="sample_id") %>%
  replace(is.na(.), 0)


library(reshape2)

# Subset the columns
first_set <- combined_corr_dpmclass[, 2]
second_set <- combined_corr_dpmclass[, 3:52]
data_subset <- combined_corr_dpmclass[, c(2, 3:52)]

# Perform pairwise correlation between columns of the two subsets
cor_matrix <- cor(first_set, second_set, method="spearman")
cmatrix<-as.matrix(cor_matrix)
p_matrix<-cor_pmat(data_subset)[1,2:51]
adjusted<-p.adjust(p_matrix, method="BH")
trans<-t(adjusted)
rownames(trans)<-c("MLS")
pmatrix<-as.matrix(trans)
```

```{r corrplot viz}
### calc sum MLS_dpm
all_data<-combined_corr_dpmgene %>%
  left_join(AMR_corr_mlsdpm_class, by="sample_id")

reorg<-cbind(all_data[1:8], all_data[59], all_data[9:58])

# Subset the columns
first_set <- reorg[, 2:9]
second_set <- reorg[, 10:59]
data_subset <- reorg[, c(2:9, 10:59)]

# Perform pairwise correlation between columns of the two subsets
cor_matrix <- cor(first_set, second_set, method="spearman")
cmatrix<-as.matrix(cor_matrix)
p_matrix<-cor_pmat(data_subset)[1:8,9:58]
pmatrix<-as.matrix(p_matrix) 
p_values_vector <- as.vector(pmatrix)
adjusted_p_values <- p.adjust(p_values_vector, method = "BH") 
adjusted_p_matrix <- matrix(adjusted_p_values, nrow = nrow(pmatrix), ncol = ncol(pmatrix))
rownames(adjusted_p_matrix)<-row.names(cmatrix)
colnames(adjusted_p_matrix)<-colnames(cmatrix)
cmatrix[is.na(cmatrix)]<-0
adjusted_p_matrix[is.na(adjusted_p_matrix)]<-1

write.csv(cmatrix,"correlation_values_4B.csv")
write.csv(pmatrix, "pvalues_4B.csv")


corrplot(cmatrix, method="circle", type='full', tl.col='black', p.mat=adjusted_p_matrix, sig.level = c(0.001, 0.01, 0.05), pch.cex = 0.6, insig = 'label_sig', pch.col = 'grey20', tl.cex = 0.6,  col=colorRampPalette(c("#3B9AB2","#EEEEEE","#F21A00"))(200))

pdf(file="4B.pdf", width=6, height=2.5)
corrplot(cmatrix, method="circle", type='full', tl.col='black', p.mat=adjusted_p_matrix, sig.level = c(0.001, 0.01, 0.05), pch.cex = 0.6, insig='label_sig', pch.col = 'grey20', tl.cex = 0.6, col=colorRampPalette(c("#3B9AB2","#EEEEEE","#F21A00"))(200))
invisible(capture.output(dev.off()))
```


