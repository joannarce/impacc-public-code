        formula_fit1 <- formula("mls_gene_count ~ group_id + sex + discretized_admit_age_quantile + event_date + ever_steroids + trajectory_group + Azith_other_one_zero:Ceftriaxone + Azith_other_one_zero:Vancomycin + Azith_other_one_zero:Cefepime + Azith_other_one_zero:Piperacillin_Tazobactam + Azith_other_one_zero:Doxycycline + Azith_other_one_zero:Meropenem + (1|enrollment_site/participant_id)")
